# =============================================================
# Naz's Collection - Environment Variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit real secrets to version control.
# =============================================================

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: server-side ONLY. Used for admin server actions
# (product/order mutations, storage uploads). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Order emails via Gmail SMTP (no custom domain needed) ---
# 1) Google Account -> Security -> 2-Step Verification (enable)
# 2) App passwords -> create one for "Mail" -> paste 16-char password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-shop@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=Naz's Collection <your-shop@gmail.com>
# Admin inbox for new-order alerts (comma-separated for multiple).
ADMIN_ORDER_EMAIL=your-admin@gmail.com

# --- Storage ---
# Public bucket name for product imagery (created by migration 0003).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images
