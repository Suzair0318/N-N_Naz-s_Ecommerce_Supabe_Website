# =============================================================
# Naz's Collection - Environment Variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit real secrets to version control.
# =============================================================

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: server-side ONLY. Used for admin server actions
# (product/order mutations, storage uploads). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storage ---
# Public bucket name for product imagery (created by migration 0003).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images
